apiVersion: v1
kind: Namespace
metadata:
  name: tlsy-aiops
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: tlsy-sa
  namespace: tlsy-aiops
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: tlsy-view-binding
subjects:
- kind: ServiceAccount
  name: tlsy-sa
  namespace: tlsy-aiops
roleRef:
  kind: ClusterRole
  name: view
  apiGroup: rbac.authorization.k8s.io
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: tlsy-metrics-binding
subjects:
- kind: ServiceAccount
  name: tlsy-sa
  namespace: tlsy-aiops
roleRef:
  kind: ClusterRole
  name: tlsy-metrics-reader
  apiGroup: rbac.authorization.k8s.io
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: tlsy-pvc
  namespace: tlsy-aiops
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: nfs-client
  resources:
    requests:
      storage: 1Gi
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: tlsy-app-code
  namespace: tlsy-aiops
data:
  app.py: |
    import json
    import urllib.request
    import ssl
    import os
    import subprocess
    from http.server import BaseHTTPRequestHandler, HTTPServer

    HTML_PAGE = """
    <!DOCTYPE html>
    <html lang="zh-CN">
    <head>
        <meta charset="UTF-8">
        <title>TLSY AIOps Copilot</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
        <style>
            body { background-color: #f8fafc; color: #1e293b; font-family: 'Inter', system-ui, sans-serif; }
            .chat-container { height: calc(100vh - 80px); overflow-y: auto; scroll-behavior: smooth; }
            .message-user { background-color: #3b82f6; color: white; border-radius: 12px 12px 0 12px; }
            .message-ai { background-color: #ffffff; border: 1px solid #e2e8f0; color: #334155; border-radius: 12px 12px 12px 0; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05); }
            .message-system { background-color: #fef2f2; border: 1px solid #fecaca; color: #991b1b; border-radius: 8px; }
            .message-ai p { margin-bottom: 8px; }
            .message-ai pre { background-color: #f1f5f9; padding: 10px; border-radius: 6px; overflow-x: auto; font-size: 13px; margin-top: 8px; position: relative; }
            .message-ai code { background-color: #f1f5f9; padding: 2px 4px; border-radius: 4px; font-family: monospace; }
            .exec-btn { position: absolute; top: 8px; right: 8px; background: #ef4444; color: white; font-size: 12px; padding: 4px 8px; border-radius: 4px; cursor: pointer; display: none; }
            pre:hover .exec-btn { display: block; }
            .nav-item { cursor: pointer; transition: all 0.2s; }
            .nav-item:hover { background-color: #e2e8f0; }
            .highlight-msg { ring: 2px; ring-color: #3b82f6; }
        </style>
    </head>
    <body class="flex h-screen overflow-hidden">
        <!-- 左侧导航 -->
        <aside class="w-64 bg-white border-r border-slate-200 flex flex-col shadow-sm z-10">
            <div class="h-16 flex items-center px-6 border-b border-slate-100">
                <span class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-500 to-teal-400">TLSY AIOps</span>
            </div>
            <nav class="flex-1 p-4 space-y-2">
                <a href="#" class="flex items-center px-4 py-3 bg-blue-50 text-blue-600 rounded-lg font-medium"><span class="mr-3">💬</span> 智能对话</a>
            </nav>
            <div class="p-4 border-t border-slate-100 text-xs text-slate-400 text-center">Powered by DeepSeek & K8s</div>
        </aside>

        <!-- 中间聊天主区域 -->
        <main class="flex-1 flex flex-col relative bg-[#f8fafc]">
            <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 shadow-sm">
                <h1 class="text-lg font-semibold text-slate-800">运维副驾驶</h1>
                <div class="flex items-center space-x-2 text-sm text-green-600 bg-green-50 px-3 py-1 rounded-full border border-green-200">
                    <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span> 大模型已连接 (全量数据已开启)
                </div>
            </header>
            <div id="chat-container" class="chat-container p-6 flex flex-col space-y-6"></div>
            <div class="p-4 bg-white border-t border-slate-200">
                <form id="chat-form" class="max-w-4xl mx-auto flex items-center space-x-3">
                    <input type="text" id="chat-input" autocomplete="off" placeholder="向副驾驶提问..." class="flex-1 px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all text-slate-700">
                    <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-3 rounded-xl font-medium shadow-sm transition-colors flex items-center">发送 <span class="ml-2">➤</span></button>
                </form>
            </div>
        </main>

        <!-- 右侧消息定位导航 -->
        <aside class="w-64 bg-white border-l border-slate-200 flex flex-col shadow-sm z-10 hidden md:flex">
            <div class="h-16 flex items-center px-6 border-b border-slate-100">
                <span class="text-md font-semibold text-slate-700">📍 消息定位</span>
            </div>
            <div id="right-nav" class="flex-1 overflow-y-auto p-2 space-y-1">
                <!-- 导航项通过 JS 动态生成 -->
            </div>
        </aside>

        <script>
            const container = document.getElementById('chat-container');
            const form = document.getElementById('chat-form');
            const input = document.getElementById('chat-input');
            const rightNav = document.getElementById('right-nav');
            let lastMessageCount = 0;

            function renderMessages(messages) {
                if (messages.length === lastMessageCount) return;
                
                // 记录当前滚动位置，避免刷新时跳回顶部
                const isAtBottom = container.scrollHeight - container.scrollTop <= container.clientHeight + 100;

                container.innerHTML = '';
                rightNav.innerHTML = '';

                if (messages.length === 0) {
                    container.innerHTML = `<div class="flex justify-start"><div class="message-ai p-4 max-w-[80%]"> 你好！我是运行在集群内部的副驾驶，我已经接入了 Metrics 和 Events 权限。你可以直接问我负载，或者让我给你排查命令（点 击“确认执行”按钮即可运行）。</div></div>`;
                }

                messages.forEach((msg, index) => {
                    const div = document.createElement('div');
                    const bubbleId = `msg-${index}`;
                    div.id = bubbleId;

                    if (msg.role === 'user') {
                        div.className = 'flex justify-end';
                        div.innerHTML = `<div class="message-user p-4 max-w-[80%]">${msg.content}</div>`;
                        
                        // 添加到右侧导航
                        addNavItem(bubbleId, `💬 ${msg.content.substring(0, 10)}...`, 'user');
                    } else if (msg.role === 'system') {
                        div.className = 'flex justify-center my-2';
                        div.innerHTML = `<div class="message-system p-3 max-w-[90%] text-sm flex items-center"><span class="text-lg mr-2">🚨</span><div><strong>系统告警：${msg.alertname}</strong><br>${marked.parse(msg.content)}</div></div>`;
                        
                        // 添加到右侧导航
                        addNavItem(bubbleId, `🚨 ${msg.alertname}`, 'system');
                    } else {
                        div.className = 'flex justify-start';
                        let html = marked.parse(msg.content);
                        html = html.replace(/<pre><code class="language-bash">([\s\S]*?)<\/code><\/pre>/g, (match, p1) => {
                            const safeCmd = p1.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&').trim();
                            return `<pre><code class="language-bash">${p1}</code><button class="exec-btn" onclick="execCmd('${safeCmd}')">⚠️ 确认执行</button></pre>`;
                        });
                        div.innerHTML = `<div class="message-ai p-4 max-w-[80%]">${html}</div>`;
                    }
                    container.appendChild(div);
                });

                lastMessageCount = messages.length;
                
                // 如果之前就在底部，或者消息很少，自动滚动到底部
                if (isAtBottom || messages.length <= 2) {
                    container.scrollTop = container.scrollHeight;
                }
            }

            function addNavItem(targetId, text, type) {
                const btn = document.createElement('div');
                btn.className = 'nav-item px-3 py-2 rounded-md text-xs text-slate-600 truncate';
                if (type === 'system') btn.classList.add('text-red-600', 'font-semibold', 'bg-red-50');
                btn.innerText = text;
                btn.onclick = () => {
                    const el = document.getElementById(targetId);
                    if (el) {
                        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        // 高亮闪烁效果
                        const bubble = el.firstElementChild;
                        if(bubble) {
                            bubble.style.boxShadow = "0 0 15px rgba(59, 130, 246, 0.8)";
                            setTimeout(() => { bubble.style.boxShadow = ""; }, 1500);
                        }
                    }
                };
                rightNav.appendChild(btn);
            }

            async function fetchMessages() {
                try {
                    const res = await fetch('/api/messages');
                    const data = await res.json();
                    renderMessages(data.messages);
                } catch (e) {}
            }

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const text = input.value.trim();
                if (!text) return;
                const tempDiv = document.createElement('div');
                tempDiv.className = 'flex justify-end';
                tempDiv.innerHTML = `<div class="message-user p-4 max-w-[80%]">${text}</div>`;
                container.appendChild(tempDiv);
                container.scrollTop = container.scrollHeight;
                input.value = '';
                fetch('/api/chat', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({text: text}) });
            });

            async function execCmd(cmd) {
                if (!confirm("⚠️ 你确认要执行以下命令吗？\\n\\n" + cmd)) return;
                const res = await fetch('/api/execute', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({cmd: cmd}) });
                const data = await res.json();
                alert("执行结果：\\n" + data.result);
            }

            setInterval(fetchMessages, 2000);
            fetchMessages();
        </script>
    </body>
    </html>
    """

    MESSAGES = []
    DATA_FILE = "/app/data/history.json"
    if os.path.exists(DATA_FILE):
        try:
            with open(DATA_FILE, "r", encoding="utf-8") as f: MESSAGES = json.load(f)
        except: pass

    def save_messages():
        try:
            os.makedirs("/app/data", exist_ok=True)
            with open(DATA_FILE, "w", encoding="utf-8") as f: json.dump(MESSAGES, f, ensure_ascii=False)
        except: pass

    DEEPSEEK_API_KEY = os.environ.get("DEEPSEEK_API_KEY", "YOUR_DEEPSEEK_API_KEY")

    def get_k8s_token():
        try:
            with open('/var/run/secrets/kubernetes.io/serviceaccount/token', 'r') as f: return f.read().strip()
        except: return None

    def get_k8s_data():
        token = get_k8s_token()
        if not token: return "无法获取 Token"
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        headers = {"Authorization": f"Bearer {token}"}
        api_base = "https://kubernetes.default.svc"

        status_data = "当前集群真实运行状态：\n"

        try:
            req = urllib.request.Request(f"{api_base}/apis/metrics.k8s.io/v1beta1/nodes", headers=headers)
            with urllib.request.urlopen(req, context=ctx, timeout=5) as response:
                metrics = json.loads(response.read().decode('utf-8'))
                status_data += "--- 节点实时负载 (CPU/内存) ---\n"
                for m in metrics.get('items', []):
                    status_data += f"节点: {m['metadata']['name']}, CPU: {m['usage']['cpu']}, 内存: {m['usage']['memory']}\n"
        except Exception as e: status_data += f"获取节点负载失败: {e}\n"

        try:
            req = urllib.request.Request(f"{api_base}/api/v1/pods?fieldSelector=status.phase!=Running,status.phase!=Succeeded", headers=headers)
            with urllib.request.urlopen(req, context=ctx, timeout=5) as response:
                pods = json.loads(response.read().decode('utf-8'))
                status_data += "\n--- 异常 Pod 列表 ---\n"
                if not pods.get('items'): status_data += "无异常 Pod。\n"
                else:
                    for p in pods['items']: status_data += f"Pod: {p['metadata']['name']}, 命名空间: {p['metadata']['namespace']}, 状态: {p['status'].get('phase')}\n"
        except Exception: status_data += "\n获取异常 Pod 失败\n"

        try:
            req = urllib.request.Request(f"{api_base}/api/v1/events?fieldSelector=type=Warning&limit=5", headers=headers)
            with urllib.request.urlopen(req, context=ctx, timeout=5) as response:
                events = json.loads(response.read().decode('utf-8'))
                status_data += "\n--- 最近 5 条 Warning 事件 ---\n"
                if not events.get('items'): status_data += "无 Warning 事件。\n"
                else:
                    for e in events['items']: status_data += f"对象: {e['involvedObject'].get('kind')}/{e['involvedObject'].get('name')}, 原因: {e.get('reason', '')}, 详情: {e.get('message', '')}\n"
        except Exception: status_data += "\n获取事件失败\n"
        return status_data

    def call_deepseek(user_text):
        k8s_info = get_k8s_data()
        url = "https://api.deepseek.com/chat/completions"
        headers = {"Content-Type": "application/json", "Authorization": f"Bearer {DEEPSEEK_API_KEY}"}
        
        sys_prompt = (
            "你是一个高级 K8s 运维专家，运行在本地集群内部（TLSY AIOps 副驾驶）。\n"
            "你现在拥有集群的只读权限，并且前端支持通过二次确认来执行你提供的 Bash 命令。\n"
            "请遵循以下规则：\n"
            "1. 如果用户问你负载、状态等，你可以直接根据【集群实时数据】回答，不要再说“我无法查看”。\n"
            "2. 如果某些信息你无法获取，请给出一段以 ```bash 开头的代码块。前端会自动生成“⚠️ 确认执行”按钮。\n"
            "3. 你不能主动执行任何修改类命令（如 delete, apply, patch），只能提供排查命令。\n"
            "【集群实时数据】\n" + k8s_info
        )

        chat_history = []
        for msg in MESSAGES[-10:]:
            if msg["role"] == "user": chat_history.append({"role": "user", "content": msg["content"]})
            elif msg["role"] == "ai": chat_history.append({"role": "assistant", "content": msg["content"]})

        data = {"model": "deepseek-chat", "messages": [{"role": "system", "content": sys_prompt}] + chat_history + [{"role": "user", "content": user_text}]}
        req = urllib.request.Request(url, data=json.dumps(data).encode('utf-8'), headers=headers, method='POST')
        try:
            with urllib.request.urlopen(req, timeout=60) as response:
                return json.loads(response.read().decode('utf-8'))['choices'][0]['message']['content']
        except Exception as e: return f"大模型请求失败: {str(e)}"

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path == '/':
                self.send_response(200); self.send_header('Content-type', 'text/html; charset=utf-8'); self.end_headers(); self.wfile.write(HTML_PAGE.encode('utf-8'))
            elif self.path == '/api/messages':
                self.send_response(200); self.send_header('Content-type', 'application/json'); self.end_headers(); self.wfile.write(json.dumps({"messages": MESSAGES}).encode('utf-8'))

        def do_POST(self):
            content_length = int(self.headers['Content-Length'])
            post_data = json.loads(self.rfile.read(content_length))

            if self.path == '/api/chat':
                user_text = post_data.get("text")
                MESSAGES.append({"role": "user", "content": user_text}); save_messages()
                ai_reply = call_deepseek(user_text)
                MESSAGES.append({"role": "ai", "content": ai_reply}); save_messages()
                self.send_response(200); self.end_headers()

            elif self.path == '/api/webhook':
                alertname = post_data.get("alertname", "未知")
                analysis = post_data.get("analysis", "无")
                MESSAGES.append({"role": "system", "alertname": alertname, "content": analysis}); save_messages()
                self.send_response(200); self.end_headers(); self.wfile.write(b'{"status": "success"}')

            elif self.path == '/api/execute':
                cmd = post_data.get("cmd", "").strip()
                forbidden = ["delete", "rm", "apply", "patch", "scale", "restart", "create", "edit", "replace"]
                if any(f in cmd for f in forbidden):
                    result = "❌ 安全拦截：只允许执行只读查询命令。"
                else:
                    try:
                        result = subprocess.check_output(cmd, shell=True, stderr=subprocess.STDOUT, text=True)
                    except subprocess.CalledProcessError as e:
                        result = e.output
                    except Exception as e:
                        result = str(e)

                self.send_response(200); self.send_header('Content-type', 'application/json'); self.end_headers()
                self.wfile.write(json.dumps({"result": result}).encode('utf-8'))

    if __name__ == '__main__':
        server = HTTPServer(('0.0.0.0', 8080), Handler)
        server.serve_forever()
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: tlsy-aiops
  namespace: tlsy-aiops
spec:
  replicas: 1
  selector:
    matchLabels: { app: tlsy-aiops }
  template:
    metadata:
      labels: { app: tlsy-aiops }
    spec:
      serviceAccountName: tlsy-sa
      nodeSelector:
        kubernetes.io/hostname: k8s-node2
      containers:
      - name: tlsy-aiops
        image: python:3.11-slim
        command: ["python", "/app/app.py"]
        ports:
        - containerPort: 8080
        env:
        - name: DEEPSEEK_API_KEY
          value: "sk-ada8e68bb32344639522aa8a7d5398b1"
        volumeMounts:
        - name: code
          mountPath: /app
        - name: data
          mountPath: /app/data
        - name: kubectl
          mountPath: /usr/local/bin/kubectl
        - name: kubeconfig
          mountPath: /root/.kube/config
        resources:
          requests: { cpu: 50m, memory: 64Mi }
          limits: { cpu: 200m, memory: 256Mi }
      volumes:
      - name: code
        configMap:
          name: tlsy-app-code
      - name: data
        persistentVolumeClaim:
          claimName: tlsy-pvc
      - name: kubectl
        hostPath:
          path: /usr/bin/kubectl
          type: File
      - name: kubeconfig
        hostPath:
          path: /root/.kube/config
          type: File
---
apiVersion: v1
kind: Service
metadata:
  name: tlsy-aiops
  namespace: tlsy-aiops
  annotations:
    metallb.universe.tf/loadBalancerIPs: 192.168.148.250
spec:
  type: LoadBalancer
  selector: { app: tlsy-aiops }
  ports:
  - name: web
    port: 80
    targetPort: 8080
