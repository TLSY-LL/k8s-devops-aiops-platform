# ==========================================
# TLSY-Cloud 环境配置模板
# 复制此文件为 .env 并填入你的真实环境信息
# ==========================================

# 基础网络 (必须修改)
MASTER_IP=192.168.148.60
NODE1_IP=192.168.148.61
NODE2_IP=192.168.148.62
VIP_IP=192.168.148.240
NFS_SERVER_IP=192.168.148.63
NFS_PATH=/netshare

# 域名后缀 (不包含前面的点，例如 kubex.com)
DOMAIN_SUFFIX=kubex.com

# GitLab 密码 (必须修改)
GITLAB_ROOT_PASSWORD=CHANGE_ME_STRONG_PWD

# Harbor 密码 (必须修改)
HARBOR_ADMIN_PASSWORD=CHANGE_ME_STRONG_PWD

# 大模型 API (AIOps 用)
DEEPSEEK_API_KEY=sk-xxx
